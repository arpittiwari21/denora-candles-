# =========================================================================
# Denora Candles API - Environment Configuration Template
# Duplicate this file to .env for local development
# In Google Cloud Run, store sensitive credentials in Google Secret Manager
# =========================================================================

# -------------------------------------------------------------------------
# Application Runtime
# -------------------------------------------------------------------------
NODE_ENV=development
PORT=8080

# -------------------------------------------------------------------------
# Database (PostgreSQL - Supabase / Neon DB)
# -------------------------------------------------------------------------
# For Supabase:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
#
# For Neon DB:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/denora_candles?sslmode=require"
#
# For Local Docker PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/denora_candles?schema=public"

# -------------------------------------------------------------------------
# Authentication & Security
# -------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="super_secret_jwt_key_denora_candles_change_in_production"
JWT_EXPIRES_IN="7d"

# -------------------------------------------------------------------------
# Frontend Integration & CORS
# -------------------------------------------------------------------------
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://denoracandles.com,https://denora-candles.vercel.app"

# -------------------------------------------------------------------------
# Payment Gateway Configuration
# -------------------------------------------------------------------------
# Set to 'razorpay' (standard for INR e-commerce) or 'stripe'
PAYMENT_GATEWAY="razorpay"

# Razorpay (Get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Stripe (Optional / Global payments from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_YourStripeSecretKeyHere"
STRIPE_WEBHOOK_SECRET="whsec_YourStripeWebhookSecretHere"
STRIPE_SUCCESS_URL="http://localhost:5173/checkout/success"
STRIPE_CANCEL_URL="http://localhost:5173/cart"
