{
  "name": "denora-candles-api",
  "version": "1.0.0",
  "description": "Production-ready backend API for Denora Candles e-commerce brand",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && prisma generate",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "clean": "rimraf dist"
  },
  "keywords": [
    "denora-candles",
    "ecommerce",
    "express",
    "typescript",
    "google-cloud-run",
    "serverless",
    "razorpay",
    "stripe",
    "postgresql",
    "prisma"
  ],
  "author": "Denora Candles Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "razorpay": "^2.9.4",
    "stripe": "^17.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.0",
    "prisma": "^5.21.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
